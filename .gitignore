# Go build artifacts
# Anchor to the repo root so the pattern matches the built binary at
# ./kbouncer WITHOUT also filtering cmd/kbouncer/ (the source-tree dir
# whose Go files MUST be tracked).
/kbouncer
*.test
*.out
*.exe
bin/
dist/

# SQLite state files (runtime)
*.db
*.db-journal
*.db-wal
*.db-shm

# IDE
.vscode/
.idea/
*.swp
.DS_Store

# Integration-test artifacts (`make test-integration`)
.kind-kubeconfig
